# Example systemd unit for the TS Shara UPS REST API (v2.0).
#
# Automated installation (recommended):
#   sudo scripts/install_service.sh
#
# Manual installation:
#   sudo install -m 0644 config/examples/ts-shara-api.service /etc/systemd/system/
#   sudo install -d /etc/ts-shara-api
#   sudo install -m 0640 config/examples/ts_shara_api.conf /etc/ts-shara-api/ts_shara_api.conf
#   sudo install -m 0644 config/examples/99-ts-shara-ups.rules /etc/udev/rules.d/
#   sudo systemctl daemon-reload && sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo systemctl enable --now ts-shara-api
#   journalctl -u ts-shara-api -f
#
# Note: the project path contains spaces. A unit file does NOT use quotes
# (systemd reads the whole value up to the end of the line); in URLs, the space
# becomes %%20 (the % sign is escaped as %% in unit files).
# Adjust WorkingDirectory/ExecStart and User for your host (the installer does it automatically).
#
# USB disconnected: the service does NOT stop. The collector keeps retrying every
# poll_interval_s and the API keeps responding -- /health = 503 "degraded" and
# /telemetry = 503 with communication.state = port_unavailable/disconnected and
# last_error set (no fictitious values). When the cable is reconnected, the udev
# rule (config/examples/99-ts-shara-ups.rules) restarts the service to reopen the
# port immediately.

[Unit]
Description=TS Shara UPS telemetry REST API (Megatec/Q1 over USB CDC-ACM)
Documentation=file:/opt/UPS%%20Monitor/TS_Shara/Universal_UPS_Senoidal_3200VA/docs/rest-api.md
After=network-online.target
Wants=network-online.target
# no restart limit: a missing cable at boot must not exhaust the attempts
StartLimitIntervalSec=0

[Service]
Type=simple
# the user must belong to the dialout group to access /dev/ttyACM0
User=upsmon
Group=dialout
WorkingDirectory=/opt/UPS Monitor/TS_Shara/Universal_UPS_Senoidal_3200VA
ExecStart=/usr/bin/python3 -m api --config /etc/ts-shara-api/ts_shara_api.conf
# always restart (crash, unhandled exception, HTTP IP/port unavailable at boot)
Restart=always
RestartSec=5
# no additional privileges; read-only service
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ts-shara-api

[Install]
WantedBy=multi-user.target
