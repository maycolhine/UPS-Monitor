# ---------------------------------------------------------------------------
# UPS Web Viewer — variáveis de ambiente
#
# Uso:  cp .env.example .env  e ajuste o endereço da API.
# Nenhum segredo/token é usado por esta aplicação (a API de origem não autentica).
# ---------------------------------------------------------------------------

# Porta publicada no host para a interface web (mapeada para a 8080 do container).
# Evite 8080 no host: é a porta usada pela API de telemetria.
VIEWER_HTTP_PORT=8090

# ----------------------------- API de origem -------------------------------
# Endereço-base da API REST de telemetria (projeto "Monitoramento UPS").
#
# ATENÇÃO: dentro do container, `localhost`/`127.0.0.1` é o PRÓPRIO container,
# nunca a máquina Ubuntu que possui o cabo USB.
#
# Opção 1 (padrão): a API precisa escutar em 0.0.0.0 (todas as interfaces),
#   ex.:  python3 scripts/run_api.py --http-host 0.0.0.0 --http-port 8080
UPS_API_BASE_URL=http://host.docker.internal:8080

# Opção 2: a API escutando apenas no IP de rede da máquina (padrão do projeto
#   de origem, 192.168.52.68). O container alcança esse IP pela rede do host.
# UPS_API_BASE_URL=http://192.168.52.68:8080

# Identificador lógico do equipamento usado nas URLs da API (API unificada: N nobreaks).
# Vazio (recomendado) = o Web Viewer descobre todos em GET /api/v1/ups e a interface
# permite escolher um por vez (o backend serve, por padrão, o primeiro com telemetria
# válida). Preencha apenas para fixar um equipamento como padrão do painel.
UPS_DEVICE_ID=

# ------------------------- Consulta à API (backend) ------------------------
# Tempo limite de cada requisição à API, em milissegundos.
UPS_API_TIMEOUT_MS=4000
# Tempo de vida do cache em memória da telemetria, em milissegundos.
# Evita repetir a consulta quando a interface atualiza em intervalos curtos.
UPS_API_CACHE_TTL_MS=1500
# Cache da identificação (muda raramente: no equipamento atual é relida a cada 1 h).
UPS_API_IDENTITY_TTL_MS=60000

# ---------------------------- Interface (frontend) -------------------------
# Intervalo de atualização automática do dashboard, em milissegundos.
VIEWER_REFRESH_INTERVAL_MS=5000

# ------------------------------- Diagnóstico -------------------------------
# debug | info | warn | error
VIEWER_LOG_LEVEL=info

# --------------------- Faixas semânticas dos gauges (opcional) -------------
# Sobrescreve as faixas vermelho/amarelo/verde PADRÃO (validadas em 2026-10-21)
# definidas em src/backend/src/gaugeConfig.ts.
# JSON, opcional. Formato: { "<métrica>": { "scale": {...}, "bands": [...] } }
# Métricas: input_voltage_v, output_voltage_v, input_frequency_hz,
#           temperature_c, battery_charge_percent, load_percent
#
# Exemplo — trocar as faixas da tensão de saída para um nobreak com saída 220 V:
# VIEWER_GAUGE_THRESHOLDS={"output_voltage_v":{"scale":{"min":0,"max":300,"ticks":[0,75,150,225,300]},"bands":[{"level":"critical","from":0,"to":198,"label":"Tensão de saída fora da faixa"},{"level":"warning","from":198,"to":209,"label":"Atenção: abaixo do ideal"},{"level":"good","from":209,"to":231,"label":"Faixa esperada (220 V)"},{"level":"warning","from":231,"to":242,"label":"Atenção: acima do ideal"},{"level":"critical","from":242,"to":300,"label":"Tensão de saída fora da faixa"}]}}
VIEWER_GAUGE_THRESHOLDS=
