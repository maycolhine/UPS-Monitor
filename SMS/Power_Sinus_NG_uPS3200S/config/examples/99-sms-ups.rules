# udev rule for the SMS Power Sinus NG uPS3200S UPS
# (Prolific USB-Serial 067b:23d3 -> /dev/ttyUSB0, pl2303 driver).
#
# Install: sudo install -m 0644 config/examples/99-sms-ups.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
# (the scripts/install_service.sh script does this automatically)

# 1) read/write permission for the dialout group
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23d3", MODE="0660", GROUP="dialout"

# 2) prevent ModemManager from probing the port with AT commands (corrupts the communication)
SUBSYSTEM=="usb", ATTR{idVendor}=="067b", ATTR{idProduct}=="23d3", ENV{ID_MM_DEVICE_IGNORE}="1"

# 3) when the cable is reconnected, reopen the port and publish the telemetry immediately:
#    restart the API (--no-block avoids blocking the udev processing).
#    On removal it does not restart: the collector detects the drop on its own and the API
#    preserves the last valid reading, marking it as `stale` (last_success_utc kept).
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23d3", ACTION=="add", RUN+="/usr/bin/systemctl restart --no-block sms-api.service"
