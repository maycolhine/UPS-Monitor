# ---------------------------------------------------------------------------
# UPS Monitor — Web Viewer — environment variables
#
# Usage:  cp .env.example .env  and adjust the API address.
# This application uses no secret/token (the upstream API does not authenticate).
# ---------------------------------------------------------------------------

# Port published on the host for the web interface (mapped to the container's 8080).
# Avoid 8080 on the host: that is the port used by the telemetry API.
VIEWER_HTTP_PORT=8090

# ----------------------------- Upstream API --------------------------------
# Base address of the telemetry REST API (the unified "upsmon" monitor service).
#
# WARNING: inside the container, `localhost`/`127.0.0.1` is the CONTAINER itself,
# never the Linux machine that owns the USB cable.
#
# Option 1 (default): the API must listen on 0.0.0.0 (all interfaces),
#   e.g.  python3 monitor/scripts/run_api.py --http-host 0.0.0.0 --http-port 8080
UPS_API_BASE_URL=http://host.docker.internal:8080

# Option 2: point directly at a loopback address reachable from the host.
# UPS_API_BASE_URL=http://127.0.0.1:8080

# Logical identifier of the device used in the API URLs (unified API: N UPS units).
# Empty (recommended) = the Web Viewer discovers all of them via GET /api/v1/ups and
# the interface lets you pick one at a time (by default the backend serves the first
# one with valid telemetry). Fill it only to pin a device as the dashboard default.
UPS_DEVICE_ID=

# ------------------------ API queries (backend) ----------------------------
# Timeout of each request to the API, in milliseconds.
UPS_API_TIMEOUT_MS=4000
# Time-to-live of the in-memory telemetry cache, in milliseconds.
# Avoids repeating the query when the interface refreshes at short intervals.
UPS_API_CACHE_TTL_MS=1500
# Identity cache (changes rarely: on the current device it is re-read every 1 h).
UPS_API_IDENTITY_TTL_MS=60000

# ---------------------------- Interface (frontend) -------------------------
# Automatic dashboard refresh interval, in milliseconds.
VIEWER_REFRESH_INTERVAL_MS=5000

# ------------------------------- Diagnostics -------------------------------
# debug | info | warn | error
VIEWER_LOG_LEVEL=info

# --------------------- Gauge semantic bands (optional) ---------------------
# Overrides the DEFAULT red/amber/green bands (validated on 2026-10-21) defined
# in src/backend/src/gaugeConfig.ts.
# Optional JSON. Format: { "<metric>": { "scale": {...}, "bands": [...] } }
# Metrics: input_voltage_v, output_voltage_v, input_frequency_hz,
#          temperature_c, battery_charge_percent, load_percent
#
# Example — change the output-voltage bands for a UPS with a 220 V output:
# VIEWER_GAUGE_THRESHOLDS={"output_voltage_v":{"scale":{"min":0,"max":300,"ticks":[0,75,150,225,300]},"bands":[{"level":"critical","from":0,"to":198,"label":"Output voltage out of range"},{"level":"warning","from":198,"to":209,"label":"Warning: below ideal"},{"level":"good","from":209,"to":231,"label":"Expected range (220 V)"},{"level":"warning","from":231,"to":242,"label":"Warning: above ideal"},{"level":"critical","from":242,"to":300,"label":"Output voltage out of range"}]}}
VIEWER_GAUGE_THRESHOLDS=
