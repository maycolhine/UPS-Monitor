# udev rule for the TS Shara UPS (STM32 Virtual ComPort 0483:5740 -> /dev/ttyACM0).
#
# Install: sudo install -m 0644 config/examples/99-ts-shara-ups.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
# (the scripts/install_service.sh script does this automatically)

# 1) read/write permission for the dialout group
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0660", GROUP="dialout"

# 2) prevent ModemManager from probing the port with AT commands (corrupts communication)
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="5740", ENV{ID_MM_DEVICE_IGNORE}="1"

# 3) on cable reconnection, reopen the port and publish telemetry immediately:
#    restart the API (--no-block avoids blocking udev processing).
#    On removal it does not restart: the collector detects the drop on its own and
#    the API preserves the last valid reading, marking it as `stale`
#    (last_success_utc kept).
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ACTION=="add", RUN+="/usr/bin/systemctl restart --no-block ts-shara-api.service"
